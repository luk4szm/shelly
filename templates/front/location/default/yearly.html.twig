{% extends 'front/location/default/index.html.twig' %}

{% block buttons %}
    <div class="btn-group me-2" role="group" id="location-chart-type-toggle">
        <input type="radio" class="btn-check" name="location-chart-type" id="location-type-weeks" value="weeks" checked>
        <label class="btn" for="location-type-weeks">t</label>
        <input type="radio" class="btn-check" name="location-chart-type" id="location-type-months" value="months">
        <label class="btn" for="location-type-months">mc</label>
    </div>
    <div class="input-group">
        <button class="btn" type="button" id="prev-year-btn" aria-label="Poprzedni rok">&#8592;</button>
        <input type="number" class="form-control" id="location_date"
               value="{{ app.request.query.get('date') matches '/^\\d{4}$/' ? app.request.query.get('date') : '' }}"
               min="2025" max="{{ "now"|date("Y") }}" />
        <button class="btn" type="button" id="next-year-btn" aria-label="Następny rok">&#8594;</button>
    </div>
{% endblock %}

{% block pageBody %}
    {{ parent() }}
    <div class="container-xl">
        <div class="row row-deck row-cards">
            <div class="col-12">
                <div class="card">
                    <div class="card-body" style="min-height: 432px;">
                        <div id="location-chart-temperature" class="position-relative" data-location-slug="{{ location }}" data-chart-type="yearly"></div>
                    </div>
                </div>
            </div>
            <div class="col-12">
                <div class="card">
                    <div class="card-body" style="min-height: 432px;">
                        <div id="location-chart-humidity" class="position-relative" data-location-slug="{{ location }}" data-chart-type="yearly"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block pagejs %}
    {{ parent() }}
    <script src="{{ asset('js/location_chart_yearly.js') }}"></script>
{% endblock %}
