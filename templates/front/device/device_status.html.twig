{% set currentStatus = device.currentStatus|first %}
{% set dailyStats = device.dailyStats|default(null) %}
{% set isDeviceActive = device.switch is not null
    ? device.switch.isOn is same as(true)
    : (currentStatus and currentStatus.status == constant('App\\Model\\Status::ACTIVE')) %}

<style>
    .long-press-btn {
        position: relative;
        overflow: hidden;
        -webkit-tap-highlight-color: transparent;
    }

    .long-press-btn::before {
        content: '';
        position: absolute;
        inset: 0;
        width: 0;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.2);
        transition: width 350ms linear;
    }

    .long-press-btn.is-holding::before {
        width: 100%;
    }

    .long-press-btn span {
        position: relative;
        z-index: 1;
    }
</style>

<div class="mb-3">
    <div class="device-status-item" id="device_status">
        <div class="card card-sm">
            <div class="card-body py-2">
                <div class="row align-items-center">
                    <div class="col-auto p-1">
                        <span class="device-switch-state {{ isDeviceActive ? 'bg-success' : 'bg-light-lt' }} avatar"></span>
                    </div>
                    <div class="col">
                        <div class="fw-bolder fs-3">
                            {{ currentStatus ? currentStatus.lastValue : 0 }} W
                        </div>
                        <div class="text-secondary text-capitalize fw-bold">
                            <a href="{{ path('app_front_device_daily', {'device': device.name}) }}" class="text-secondary">
                                {{ device.name|trans({}, 'device') }}
                            </a>
                        </div>
                    </div>
                    <div class="col-auto text-end">
                        <div class="ms-3 float-right font-weight-medium {{ isDeviceActive ? 'text-green' : 'text-yellow' }} current-status-duration">
                            {{ currentStatus ? currentStatus.statusDuration|readableDurationTime : '00:00:00' }}
                        </div>
                        <div class="float-right text-muted fs-base">
                            <span>&#8593; {{ dailyStats ? dailyStats.inclusions : 0 }}</span>
                            <span class="ms-1">&#9202; {{ dailyStats and dailyStats.totalActiveTime ? dailyStats.totalActiveTime|readableDurationTime : 0 }}</span>
                            <br>
                            <span class="ms-1">&#128498; {{ dailyStats ? dailyStats.energy|format_energy : '0 Wh' }}</span>
                        </div>
                    </div>
                </div>
                <div class="row align-items-center">
                    {% if device.switch is not null %}
                        <div class="mt-2">
                            <button type="button"
                                    class="btn btn-6 btn-azure w-100 long-press-btn"
                                    data-controller="switch"
                                    data-action="{{ device.switch.isOn is same as(true) ? 'off' : 'on' }}"
                                    data-device-id="{{ device.switch.deviceId }}"
                                    data-channel="{{ device.switch.channel }}">
                                <span>{{ device.switch.isOn is same as(true) ? 'Wyłącz' : 'Włącz' }}</span>
                            </button>
                            <div class="scene-controller-status"></div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
